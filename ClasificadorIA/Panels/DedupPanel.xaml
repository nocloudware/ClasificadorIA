<UserControl x:Class="ClasificadorIA.Panels.DedupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceAltBrush}"
            CornerRadius="6"
            Padding="8,6">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Style="{DynamicResource AetherCaptionStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="SameNameCheck"
                          Style="{DynamicResource AetherCheckBoxStyle}"
                          IsChecked="True"
                          Margin="0,0,10,0"/>
                <CheckBox x:Name="MinSizeCheck"
                          Style="{DynamicResource AetherCheckBoxStyle}"
                          IsChecked="True"
                          Margin="0,0,10,0"/>
                <CheckBox x:Name="MinDateCheck"
                          Style="{DynamicResource AetherCheckBoxStyle}"
                          IsChecked="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>