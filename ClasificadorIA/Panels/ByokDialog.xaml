<Window x:Class="ClasificadorIA.Panels.ByokDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{Binding ByokDialogTitle, RelativeSource={RelativeSource Self}}"
        Width="520" Height="600"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
            <Style x:Key="FieldLabelTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
        </Window.Resources>

        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding ByokDialogTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding ByokDialogSubtitle, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="1" VerticalAlignment="Top" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,0,0">

                <!-- Proveedor -->
                <TextBlock Text="{Binding ProviderLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{DynamicResource FieldLabelTextBlockStyle}"/>
                <ComboBox x:Name="ProviderCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          DisplayMemberPath="Name"
                          SelectionChanged="ProviderCombo_SelectionChanged"/>

                <!-- Esquema -->
                <TextBlock Text="{Binding SchemeLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{DynamicResource FieldLabelTextBlockStyle}"
                           Margin="0,10,0,0"/>
                <ComboBox x:Name="SchemeCombo"
                         Style="{DynamicResource ThemedComboBoxStyle}"/>

                <!-- Base URL -->
                <TextBlock Text="{Binding BaseUrlLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{DynamicResource FieldLabelTextBlockStyle}"
                           Margin="0,10,0,0"/>
                <TextBox x:Name="BaseUrlBox"
                         Style="{DynamicResource AetherTextBoxStyle}"/>

                <!-- API key -->
                <TextBlock Text="{Binding ApiKeyLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{DynamicResource FieldLabelTextBlockStyle}"
                           Margin="0,10,0,0"/>
                <TextBox x:Name="ApiKeyBox" VerticalContentAlignment="Center"
                         Style="{DynamicResource AetherTextBoxStyle}"/>

                <!-- Página de API key -->
                <StackPanel Margin="0,6,0,0">
                    <TextBlock x:Name="ApiKeyLink"
                               Visibility="Collapsed">
                        <Hyperlink x:Name="ApiKeyHyperlink"
                                   Click="ApiKeyHyperlink_Click"
                                   TextDecorations="Underline"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                    <TextBox x:Name="ApiKeyUrlBox"
                         Visibility="Collapsed"
                         VerticalContentAlignment="Center"
                         Style="{DynamicResource AetherTextBoxStyle}"/>
                </StackPanel>

                <!-- Modelos -->
                <TextBlock Text="{Binding ModelLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{DynamicResource FieldLabelTextBlockStyle}"
                           Margin="0,10,0,0"/>
                <DockPanel>
                    <Button x:Name="ReloadModelsButton"
                            DockPanel.Dock="Right"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            ToolTip="{Binding ReloadModelsLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="6"
                            Margin="8,0,0,0"
                            Click="ReloadModelsButton_Click">
                        <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="16"/>
                    </Button>
                    <ComboBox x:Name="ModelCombo"
                      Style="{DynamicResource ThemedComboBoxStyle}"
                      ToolTip="{Binding ModelHint, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </DockPanel>
                <TextBlock Text="{Binding ModelHint, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="ModelLimitText"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>

                <!-- Temperatura -->
                <TextBlock Text="{Binding TemperatureLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{DynamicResource FieldLabelTextBlockStyle}"
                           Margin="0,10,0,0"/>
                <DockPanel>
                    <TextBlock x:Name="TemperatureValueText"
                               DockPanel.Dock="Right"
                               Width="40"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Slider x:Name="TemperatureSlider"
                        Style="{DynamicResource AetherSliderStyle}"
                        Minimum="0" Maximum="1"
                        IsSnapToTickEnabled="True"
                        TickFrequency="0.05"
                        ToolTip="{Binding TemperatureHint, RelativeSource={RelativeSource AncestorType=Window}}"
                        ValueChanged="TemperatureSlider_ValueChanged"/>
                </DockPanel>

                <!-- Máx. tokens -->
                <TextBlock Text="{Binding MaxTokensLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{DynamicResource FieldLabelTextBlockStyle}"
                           Margin="0,10,0,0"/>
                <DockPanel>
                    <TextBlock x:Name="MaxTokensValueText"
                               DockPanel.Dock="Right"
                               Width="56"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Slider x:Name="MaxTokensSlider"
                        Style="{DynamicResource AetherSliderStyle}"
                        Minimum="4096" Maximum="32768"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1024"
                        ToolTip="{Binding MaxTokensHint, RelativeSource={RelativeSource AncestorType=Window}}"
                        IsEnabled="False"
                        ValueChanged="MaxTokensSlider_ValueChanged"/>
                </DockPanel>
                <CheckBox x:Name="AutoTokensCheck"
                          Style="{DynamicResource AetherCheckBoxStyle}"
                          IsChecked="True"
                          Margin="0,4,0,0"
                          Click="AutoTokensCheck_Click"/>

                <!-- Estado -->
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,10,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="DeleteButton"
                    Content="{Binding DeleteLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Left"
                    Click="DeleteButton_Click"/>
            <Button x:Name="TestButton"
                    Content="{Binding TestConnectionLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="TestButton_Click"/>
            <Button x:Name="SaveButton"
                    Content="{Binding SaveLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="{Binding CancelLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>