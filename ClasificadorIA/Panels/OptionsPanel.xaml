<UserControl x:Class="ClasificadorIA.Panels.OptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="PanelTitleText"
                       Style="{DynamicResource AppTitleStyle}"
                       FontSize="15"/>
            <TextBlock x:Name="PanelSubtitleText"
                       Style="{DynamicResource AppTaglineStyle}"
                       FontSize="11"/>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,12,8">

                <!-- 1. Eliminar duplicados -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,2,0,0">
                    <StackPanel>
                        <TextBlock x:Name="DedupTitleText"
                                   Style="{DynamicResource AetherCaptionStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="SameNameCheck"
                                      Style="{DynamicResource AetherCheckBoxStyle}"
                                      IsChecked="True"
                                      Margin="0,0,10,0"/>
                            <CheckBox x:Name="MinSizeCheck"
                                      Style="{DynamicResource AetherCheckBoxStyle}"
                                      IsChecked="True"
                                      Margin="0,0,10,0"/>
                            <CheckBox x:Name="MinDateCheck"
                                      Style="{DynamicResource AetherCheckBoxStyle}"
                                      IsChecked="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Método -->
                <TextBlock x:Name="MethodLabel"
                           Style="{DynamicResource AetherCaptionStyle}"
                           Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="MethodLocal"
                                 Style="{DynamicResource AetherRadioButtonStyle}"
                                 IsChecked="True"
                                 Margin="0,0,16,0"/>
                    <RadioButton x:Name="MethodIa"
                                 Style="{DynamicResource AetherRadioButtonStyle}"/>
                </StackPanel>
                <Button x:Name="ByokButton"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource TextButtonStyle}"
                        Margin="0,2,0,0"
                        Padding="0"
                        Visibility="Collapsed"/>

                <!-- 3. Modo / Criterio / Profundidad -->
                <TextBlock x:Name="ModeLabel"
                           Style="{DynamicResource AetherCaptionStyle}"
                           Margin="0,8,0,0"/>
                <ComboBox x:Name="ModeCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          SelectionChanged="ModeCombo_SelectionChanged"
                          Margin="0,4,0,6"/>

                <TextBlock x:Name="CriterionLabel"
                           Style="{DynamicResource AetherCaptionStyle}"/>
                <ComboBox x:Name="CriterionCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          Margin="0,4,0,6"/>

                <TextBlock x:Name="DepthLabel"
                           Style="{DynamicResource AetherCaptionStyle}"/>
                <ComboBox x:Name="DepthCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          Margin="0,4,0,6"/>

                <!-- 4. Tamaño de lote -->
                <TextBlock x:Name="BatchSizeLabel"
                           Style="{DynamicResource AetherCaptionStyle}"/>
                <ComboBox x:Name="BatchSizeCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          Margin="0,4,0,6"/>

                <!-- 5. Copiar / Mover -->
                <TextBlock x:Name="OutputModeLabel"
                           Style="{DynamicResource AetherCaptionStyle}"
                           Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="CopyRadio"
                                 Style="{DynamicResource AetherRadioButtonStyle}"
                                 IsChecked="True"
                                 Margin="0,0,16,0"/>
                    <RadioButton x:Name="MoveRadio"
                                 Style="{DynamicResource AetherRadioButtonStyle}"/>
                </StackPanel>

                <!-- 6. Clasificar -->
                <Button x:Name="ClassifyBtn"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Padding="24,8"/>
                <TextBlock x:Name="PanelHintText"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>