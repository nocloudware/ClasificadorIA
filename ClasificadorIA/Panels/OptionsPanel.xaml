<UserControl x:Class="ClasificadorIA.Panels.OptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="PanelTitleText"
                       Style="{DynamicResource AppTitleStyle}"
                       FontSize="15"/>
            <TextBlock x:Name="PanelSubtitleText"
                       Style="{DynamicResource AppTaglineStyle}"
                       FontSize="11"/>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,12,8">

                <!-- 1. Carpeta de origen -->
                <TextBlock x:Name="SourceFolderLabel"
                           Style="{DynamicResource AetherCaptionStyle}"/>
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PathText"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Style="{DynamicResource AetherLabelStyle}"/>
                    <Button x:Name="ChangeBtn"
                            Grid.Column="1"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Padding="10,3"/>
                </Grid>

                <!-- 2. Método -->
                <TextBlock x:Name="MethodLabel"
                           Style="{DynamicResource AetherCaptionStyle}"
                           Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="MethodManual"
                                 Style="{DynamicResource AetherRadioButtonStyle}"
                                 Margin="0,0,16,0"/>
                    <RadioButton x:Name="MethodAuto"
                                 Style="{DynamicResource AetherRadioButtonStyle}"/>
                </StackPanel>
                <Button x:Name="ByokButton"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource TextButtonStyle}"
                        Margin="0,2,0,0"
                        Padding="0"/>

                <!-- 3. Modo / Criterio / Profundidad -->
                <TextBlock x:Name="ModeLabel"
                           Style="{DynamicResource AetherCaptionStyle}"
                           Margin="0,8,0,0"/>
                <ComboBox x:Name="ModeCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          SelectionChanged="ModeCombo_SelectionChanged"
                          Margin="0,4,0,6"/>

                <TextBlock x:Name="CriterionLabel"
                           Style="{DynamicResource AetherCaptionStyle}"/>
                <ComboBox x:Name="CriterionCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          Margin="0,4,0,6"/>

                <TextBlock x:Name="DepthLabel"
                           Style="{DynamicResource AetherCaptionStyle}"/>
                <ComboBox x:Name="DepthCombo"
                          Style="{DynamicResource ThemedComboBoxStyle}"
                          Margin="0,4,0,6"/>

                <!-- 4. Prompt -->
                <TextBlock x:Name="PromptSectionLabel"
                           Style="{DynamicResource AetherCaptionStyle}"
                           Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="GeneratePromptBtn"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="10,3"
                            Margin="0,0,8,0"/>
                    <Button x:Name="CopyPromptBtn"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="10,3"/>
                </StackPanel>
                <TextBox x:Name="PromptPreviewBox"
                         Style="{DynamicResource AetherTextBoxStyle}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         MinHeight="80"
                         MaxHeight="140"
                         TextWrapping="Wrap"
                         Margin="0,6,0,6"/>

                <!-- 5. Respuesta de la IA -->
                <TextBlock x:Name="ResponseSectionLabel"
                           Style="{DynamicResource AetherCaptionStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="PasteResponseBtn"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="10,3"
                            Margin="0,0,8,0"/>
                    <Button x:Name="LoadResponseBtn"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="10,3"/>
                </StackPanel>
                <TextBox x:Name="ResponseBox"
                         Style="{DynamicResource AetherTextBoxStyle}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         MinHeight="120"
                         MaxHeight="200"
                         TextWrapping="Wrap"
                         Margin="0,6,0,6"/>

                <!-- 6. Clasificar -->
                <Button x:Name="ClassifyBtn"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Padding="24,8"/>
                <TextBlock x:Name="PanelHintText"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>