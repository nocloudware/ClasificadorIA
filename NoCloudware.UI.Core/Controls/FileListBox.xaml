<UserControl x:Class="NoCloudware.UI.Core.Controls.FileListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListBox x:Name="FileListBoxControl"
             Background="Transparent"
             BorderThickness="0"
             AllowDrop="True"
             ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
             DragEnter="OnDragEnter"
             Drop="OnDrop"
             ContextMenuOpening="OnContextMenuOpening">
        <ListBox.Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource AetherFileListBoxStyle}">
                <Setter Property="AllowDrop" Value="True"/>
            </Style>
        </ListBox.Style>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="{Binding ItemMargin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="{Binding FileName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusColor}"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding RemoveMenuItemText, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="OnRemoveClicked"/>
                <MenuItem Header="{Binding ClearAllMenuItemText, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="OnClearAllClicked"/>
            </ContextMenu>
        </ListBox.ContextMenu>
    </ListBox>
</UserControl>
