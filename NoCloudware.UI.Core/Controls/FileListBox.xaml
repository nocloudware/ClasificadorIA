<UserControl x:Class="NoCloudware.UI.Core.Controls.FileListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="H0" Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="160" HorizontalAlignment="Left"/>
            <TextBlock x:Name="H1" Grid.Column="2" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="160" HorizontalAlignment="Left"/>
            <TextBlock x:Name="H2" Grid.Column="3" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="160" HorizontalAlignment="Left"/>
            <TextBlock x:Name="H3" Grid.Column="4" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="160" HorizontalAlignment="Left"/>
        </Grid>

        <ListBox x:Name="FileListBoxControl" Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 AllowDrop="True"
                 SelectionMode="Extended"
                 ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 DragEnter="OnDragEnter"
                 Drop="OnDrop"
                 KeyDown="OnListKeyDown"
                 ContextMenuOpening="OnContextMenuOpening">
            <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource AetherFileListBoxStyle}">
                    <Setter Property="AllowDrop" Value="True"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource AetherFileItemStyle}"/>
                </Style>
            </ListBox.Style>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="{Binding ItemMargin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding FileName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding MetadataCells[0]}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding MetadataCells[1]}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding MetadataCells[2]}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding MetadataCells[3]}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="5"
                                   Text="{Binding StatusText}"
                                   Foreground="{Binding StatusColor}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="6"
                                Click="OnRowRemoveClick"
                                Content="✕"
                                Foreground="#E81123"
                                FontSize="11"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,0"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Focusable="False"
                                ToolTip="{Binding RemoveMenuItemText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RemoveItem" Header="Remove" Click="OnRemoveClicked"/>
                    <MenuItem x:Name="ClearAllItem" Header="Clear All" Click="OnClearAllClicked"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</UserControl>
