<UserControl x:Class="NoCloudware.UI.Core.Controls.FileListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListView x:Name="FileListBoxControl"
              Background="Transparent"
              BorderThickness="0"
              AllowDrop="True"
              SelectionMode="Extended"
              ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
              DragEnter="OnDragEnter"
              Drop="OnDrop"
              KeyDown="OnListKeyDown"
              ContextMenuOpening="OnContextMenuOpening">
        <ListView.Style>
            <Style TargetType="ListView" BasedOn="{StaticResource AetherFileListViewStyle}"/>
        </ListView.Style>
        <ListView.View>
            <GridView AllowsColumnReorder="False"
                      ColumnHeaderContainerStyle="{StaticResource AetherGridColumnHeaderStyle}">
                <GridViewColumn x:Name="NameCol" Width="200">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       Margin="-5,3,0,3"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FileName}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn x:Name="MetaCol0" Width="90">
                    <GridViewColumn.Header>
                        <TextBlock x:Name="H0" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MetadataCells[0]}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="11,3,0,3"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MetadataCells[0]}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn x:Name="MetaCol1" Width="90">
                    <GridViewColumn.Header>
                        <TextBlock x:Name="H1" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MetadataCells[1]}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="11,3,0,3"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MetadataCells[1]}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn x:Name="MetaCol2" Width="90">
                    <GridViewColumn.Header>
                        <TextBlock x:Name="H2" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MetadataCells[2]}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="11,3,0,3"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MetadataCells[2]}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn x:Name="MetaCol3" Width="90">
                    <GridViewColumn.Header>
                        <TextBlock x:Name="H3" Margin="16,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MetadataCells[3]}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="11,3,0,3"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MetadataCells[3]}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn x:Name="StatusCol" Width="100">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusColor}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn x:Name="RemoveCol" Width="44">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="OnRowRemoveClick"
                                    Content="✕"
                                    Foreground="#E81123"
                                    FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,0"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    ToolTip="{Binding RemoveMenuItemText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    VerticalAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
        <ListView.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="RemoveItem" Header="Remove" Click="OnRemoveClicked"/>
                <MenuItem x:Name="ClearAllItem" Header="Clear All" Click="OnClearAllClicked"/>
            </ContextMenu>
        </ListView.ContextMenu>
    </ListView>
</UserControl>